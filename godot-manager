#!/bin/bash
# godot-manager: instala y selecciona versiones de Godot en $GODOT_DIR.
#
#   $GODOT_DIR/versions/<nombre>/godot   binario (o symlink) de cada version
#   $GODOT_DIR/current                   symlink a la version default global
#   <proyecto>/.godot-version            version fijada para un proyecto
set -e

GODOT_DIR="${GODOT_DIR:-/opt/godot}"
VERSIONS_DIR="$GODOT_DIR/versions"
BUILDS_REPO="godotengine/godot-builds"
GITHUB_API="https://api.github.com/repos/${BUILDS_REPO}"
GITHUB_DL="https://github.com/${BUILDS_REPO}/releases/download"
TEMPLATES_BASE="${XDG_DATA_HOME:-$HOME/.local/share}/godot/export_templates"
# simbolos de templates que baja --debugsymbols sin lista explicita
DEFAULT_TEMPLATE_SYMBOLS="linux_debug.x86_64,linux_release.x86_64"
TEMPLATE_PLATFORMS="android ios linux macos visionos web windows"

die() {
    echo "Error: $*" >&2
    exit 1
}

# Imprime el binario de una version instalada, o aborta si no existe.
require_installed() {
    local name="$1"
    [ -n "$name" ] || die "falta el nombre de la version"
    local bin="$VERSIONS_DIR/$name/godot"
    [ -x "$bin" ] || die "'$name' no esta instalada (ver 'godot-manager list')"
    echo "$bin"
}

# Busca un .godot-version subiendo desde el directorio actual; si no hay,
# usa la default global. Imprime el binario a ejecutar.
resolve() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/.godot-version" ]; then
            local ver
            ver=$(<"$dir/.godot-version")
            [ -x "$VERSIONS_DIR/$ver/godot" ] \
                || die "version '$ver' (de $dir/.godot-version) no esta instalada"
            echo "$VERSIONS_DIR/$ver/godot"
            return
        fi
        dir=$(dirname "$dir")
    done
    [ -x "$GODOT_DIR/current" ] || die "no hay version default (usa 'godot-manager set <ver>')"
    echo "$GODOT_DIR/current"
}

# Descarga url a dest y compara su hash contra expected.
# algo: sha256 | sha512. expected vacio = se omite la verificacion con aviso.
download_verified() {
    local url="$1" dest="$2" algo="$3" expected="$4"
    echo "Descargando $url..."
    wget -q --show-progress "$url" -O "$dest" \
        || die "no se pudo descargar. Revisa el tag exacto con 'godot-manager list-remote'."

    if [ -z "$expected" ]; then
        echo "Aviso: no hay checksum publicado para $(basename "$url"), se omite verificacion" >&2
        return
    fi
    local actual
    actual=$("${algo}sum" "$dest" | awk '{print $1}')
    if [ "$actual" != "$expected" ]; then
        echo "Error: el checksum de $(basename "$url") no coincide" >&2
        echo "  esperado: $expected" >&2
        echo "  obtenido: $actual" >&2
        return 1
    fi
    echo "Checksum verificado OK"
}

# sha512 del manifest oficial releases/godot-<tag>.json de godot-builds.
manifest_checksum() {
    local tag="$1" asset="$2"
    curl -s "https://raw.githubusercontent.com/${BUILDS_REPO}/main/releases/godot-${tag}.json" \
        | jq -r --arg f "$asset" '.files[]? | select(.filename==$f) | .checksum // empty' 2>/dev/null
}

# Digest que expone la API de GitHub para un asset ("sha256:<hex>").
# Imprime "missing" si la release no tiene ese asset.
github_digest() {
    local tag="$1" asset="$2"
    curl -s "${GITHUB_API}/releases/tags/${tag}" \
        | jq -r --arg f "$asset" '
            [.assets[]? | select(.name==$f)]
            | if length == 0 then "missing" else (.[0].digest // "" | sub("^sha256:"; "")) end'
}

cmd_list() {
    local current_target
    current_target=$(readlink -f "$GODOT_DIR/current" 2>/dev/null || true)
    echo "Versiones instaladas:"
    for v in "$VERSIONS_DIR"/*/; do
        [ -d "$v" ] || continue
        local name extra="" mark="   "
        name=$(basename "$v")
        compgen -G "$v*.debugsymbols" > /dev/null && extra=" [+simbolos]"
        [ "$current_target" = "$(readlink -f "$v/godot")" ] && mark="  *" && extra="$extra (default)"
        echo "$mark $name$extra"
    done
}

# godot-builds mezcla stables y pre-releases (dev/beta/rc) en el mismo repo,
# se distinguen por el flag "prerelease" que expone la API de GitHub.
cmd_list_remote() {
    local data
    data=$(curl -s "${GITHUB_API}/releases?per_page=60")
    case "$1" in
        dev)
            echo "Dev snapshots / pre-releases (beta, rc, dev):"
            jq -r '.[] | select(.prerelease==true) | .tag_name' <<<"$data"
            ;;
        stable)
            echo "Versiones estables:"
            jq -r '.[] | select(.prerelease==false) | .tag_name' <<<"$data"
            ;;
        latest)
            # la API devuelve las releases ordenadas por fecha de creacion (mas nueva primero)
            echo "Ultima estable:  $(jq -r '[.[] | select(.prerelease==false)][0].tag_name' <<<"$data")"
            echo "Ultima dev/pre-release: $(jq -r '[.[] | select(.prerelease==true)][0].tag_name' <<<"$data")"
            ;;
        *)
            echo "Todas las versiones (usa 'stable', 'dev' o 'latest' para filtrar):"
            jq -r '.[] | .tag_name' <<<"$data"
            ;;
    esac
}

cmd_set() {
    local bin
    bin=$(require_installed "$1")
    ln -sfn "$bin" "$GODOT_DIR/current"
    echo "Default seteado a $1"
}

cmd_set_local() {
    require_installed "$1" > /dev/null
    echo "$1" > "$PWD/.godot-version"
    echo "Version local seteada a $1 en $PWD/.godot-version"
}

cmd_which() {
    resolve
}

cmd_run() {
    local bin
    bin=$(resolve)
    exec "$bin" "$@"
}

cmd_launch() {
    local bin
    bin=$(require_installed "$1")
    shift
    exec "$bin" "$@"
}

cmd_add() {
    local name="$1" src="$2"
    [ -n "$name" ] && [ -n "$src" ] || die "uso: godot-manager add <nombre> <ruta-al-binario> [--symlink]"
    [ -x "$src" ] || die "$src no existe o no es ejecutable"
    mkdir -p "$VERSIONS_DIR/$name"
    if [ "$3" = "--symlink" ]; then
        ln -sfn "$(readlink -f "$src")" "$VERSIONS_DIR/$name/godot"
        echo "Agregado '$name' como symlink a $src"
    else
        install -m 755 "$src" "$VERSIONS_DIR/$name/godot"
        echo "Agregado '$name' (copiado desde $src)"
    fi
}

# Desde 4.8-beta1 cada release trae un .debugsymbols aparte (ELF con solo la
# info de debug). El binario oficial lo referencia por nombre via .gnu_debuglink,
# asi que alcanza con dejarlo al lado del binario: gdb/addr2line lo encuentran
# solos, sin flags al lanzar. No esta en el manifest, se verifica contra el
# digest sha256 que expone la API de GitHub para cada asset.
cmd_symbols() {
    local name="$1"
    [ -n "$name" ] || die "uso: godot-manager symbols <version>[-mono]"
    require_installed "$name" > /dev/null

    local ver="$name" symfile
    if [[ "$name" == *-mono ]]; then
        ver="${name%-mono}"
        symfile="Godot_v${ver}_mono_linux.x86_64.debugsymbols"
    else
        symfile="Godot_v${ver}_linux.x86_64.debugsymbols"
    fi
    local asset="${symfile}.zip"

    if [ -f "$VERSIONS_DIR/$name/$symfile" ]; then
        echo "'$name' ya tiene los simbolos de debug."
        return
    fi

    local digest
    digest=$(github_digest "$ver" "$asset")
    [ "$digest" != "missing" ] \
        || die "la release '$ver' no tiene $asset (existen desde 4.8-beta1, y solo para builds oficiales)"

    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    echo "Simbolos de debug: ~470 MB de descarga, ~1.3 GB en disco"
    download_verified "${GITHUB_DL}/${ver}/${asset}" "$TMP/symbols.zip" sha256 "$digest"
    unzip -q "$TMP/symbols.zip" "$symfile" -d "$VERSIONS_DIR/$name/"
    rm -rf "$TMP"
    trap - EXIT
    echo "Simbolos de debug instalados en $VERSIONS_DIR/$name/$symfile"
}

# Carpeta de templates que espera el editor para un tag oficial:
# "4.8-beta1" -> "4.8.beta1", "4.3-stable" -> "4.3.stable", + ".mono".
templates_name() {
    local name="${1/-/.}"
    [ "$2" = true ] && name="$name.mono"
    echo "$name"
}

# Valida una lista "linux,web" de plataformas y la imprime separada por espacios.
parse_platforms() {
    local p out=()
    for p in ${1//,/ }; do
        [[ " $TEMPLATE_PLATFORMS " == *" $p "* ]] \
            || die "plataforma desconocida '$p' (validas: $TEMPLATE_PLATFORMS)"
        out+=("$p")
    done
    [ ${#out[@]} -gt 0 ] || die "--platforms necesita al menos una plataforma"
    echo "${out[*]}"
}

# Los archivos de cada plataforma en el tpz empiezan con su nombre
# (linux_debug.x86_64, macos.zip, web_release.zip...).
platform_installed() {
    find "$1" -maxdepth 1 -name "$2*" ! -name '*.debugsymbols' 2>/dev/null | grep -q .
}

# Extrae de un zip remoto solo las entradas que empiezan con alguno de los
# prefijos, sin bajarlo entero (como el Export Template Manager del editor):
# lee el indice (central directory) del final del archivo y despues pide con
# HTTP Range el tramo de cada entrada. Cada archivo se verifica con su CRC32.
remote_unzip() {
    python3 -I - "$@" <<'PY'
import os, struct, sys, urllib.request, zlib

url, dest, *prefixes = sys.argv[1:]

def get(rng):
    req = urllib.request.Request(url, headers={"Range": "bytes=" + rng, "User-Agent": "godot-manager"})
    try:
        r = urllib.request.urlopen(req, timeout=60)
    except Exception as e:
        sys.exit(f"Error: no se pudo descargar {url}: {e}")
    if r.status != 206:
        sys.exit("Error: el servidor no soporta descargas parciales")
    return r

# el storage de GitHub no acepta rangos por sufijo (bytes=-N): primero el tamaño
try:
    head = urllib.request.urlopen(urllib.request.Request(
        url, method="HEAD", headers={"User-Agent": "godot-manager"}), timeout=60)
except Exception as e:
    sys.exit(f"Error: no se pudo descargar {url}: {e}")
size = int(head.headers["Content-Length"])
tail = get(f"{max(0, size - 65536)}-{size - 1}").read()
eocd = tail.rfind(b"PK\x05\x06")
if eocd < 0:
    sys.exit("Error: no se encontro el indice del zip")
count, cd_size, cd_off = struct.unpack_from("<HII", tail, eocd + 10)
if cd_off == 0xFFFFFFFF:
    sys.exit("Error: zip64 no soportado")
tail_start = size - len(tail)
if cd_off >= tail_start:
    cd = tail[cd_off - tail_start:cd_off - tail_start + cd_size]
else:
    cd = get(f"{cd_off}-{cd_off + cd_size - 1}").read()

entries, pos = [], 0
for _ in range(count):
    (sig, _, _, flags, method, _, _, crc, csize, usize,
     nlen, xlen, clen, _, _, _, off) = struct.unpack_from("<IHHHHHHIIIHHHHHII", cd, pos)
    if sig != 0x02014B50:
        sys.exit("Error: indice del zip invalido")
    name = cd[pos + 46:pos + 46 + nlen].decode()
    pos += 46 + nlen + xlen + clen
    if name.endswith("/") or not name.startswith(tuple(prefixes)):
        continue
    if ".." in name.split("/") or name.startswith("/"):
        sys.exit(f"Error: ruta invalida en el zip: {name}")
    if flags & 1 or method not in (0, 8):
        sys.exit(f"Error: {name} usa un formato no soportado")
    entries.append((name, method, crc, csize, usize, off))

total = sum(e[3] for e in entries)
print(f"{len(entries)} archivos, {total / 2**20:.0f} MB a descargar", flush=True)
done = 0
tty = sys.stderr.isatty()
for name, method, crc, csize, usize, off in entries:
    nlen, xlen = struct.unpack_from("<HH", get(f"{off}-{off + 29}").read(), 26)
    start = off + 30 + nlen + xlen
    out_path = os.path.join(dest, name)
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    dec = zlib.decompressobj(-15) if method == 8 else None
    got_crc = 0
    with open(out_path, "wb") as out:
        if csize:
            r = get(f"{start}-{start + csize - 1}")
            while chunk := r.read(1 << 20):
                data = dec.decompress(chunk) if dec else chunk
                got_crc = zlib.crc32(data, got_crc)
                out.write(data)
                done += len(chunk)
                if tty:
                    print(f"\r  {done / 2**20:6.0f}/{total / 2**20:.0f} MB  {os.path.basename(name):<40}",
                          end="", file=sys.stderr, flush=True)
        if dec:
            data = dec.flush()
            got_crc = zlib.crc32(data, got_crc)
            out.write(data)
    if got_crc != crc or os.path.getsize(out_path) != usize:
        sys.exit(f"\nError: {name} llego corrupto (CRC32 no coincide)")
if tty and entries:
    print(file=sys.stderr)
PY
}

# Export templates oficiales. Se instalan donde los busca el editor,
# $TEMPLATES_BASE/<version.txt del tpz>. El tpz es un solo zip con todas las
# plataformas; se bajan solo los archivos de las pedidas que falten.
install_templates() {
    local ver="$1" mono="$2" platforms="$3" prefix=""
    [ "$mono" = true ] && prefix="mono_"
    local name dest p missing=()
    name=$(templates_name "$ver" "$mono")
    dest="$TEMPLATES_BASE/$name"
    for p in $platforms; do
        platform_installed "$dest" "$p" || missing+=("$p")
    done
    if [ ${#missing[@]} -eq 0 ]; then
        echo "Los export templates de '$ver' ($platforms) ya estan instalados en $dest"
        return
    fi
    local asset="Godot_v${ver}_${prefix}export_templates.tpz"

    mkdir -p "$TEMPLATES_BASE"
    # al lado del destino, para que el mv final no copie entre filesystems
    TMP=$(mktemp -d -p "$TEMPLATES_BASE" .godot-manager.XXXXXX)
    trap 'rm -rf "$TMP"' EXIT
    echo "Export templates (${missing[*]}) desde ${GITHUB_DL}/${ver}/${asset}"
    local prefixes=(templates/version.txt templates/icudt_godot.dat)
    for p in "${missing[@]}"; do prefixes+=("templates/$p"); done
    remote_unzip "${GITHUB_DL}/${ver}/${asset}" "$TMP" "${prefixes[@]}"

    [ -f "$TMP/templates/version.txt" ] || die "el tpz no tiene version.txt"
    local got
    got=$(tr -d '[:space:]' < "$TMP/templates/version.txt")
    [ "$got" = "$name" ] || die "el tpz es de la version '$got', se esperaba '$name'"
    mkdir -p "$dest"
    mv -f "$TMP/templates/"* "$dest/"
    rm -rf "$TMP"
    trap - EXIT
    for p in "${missing[@]}"; do
        platform_installed "$dest" "$p" || echo "Aviso: '$ver' no trae templates de $p" >&2
    done
    echo "Export templates instalados en $dest ($(du -sh "$dest" | cut -f1))"
}

# Si esta instalado el template al que corresponden unos simbolos.
symbols_template_installed() {
    local dest="$1" id="$2"
    case "$id" in
        macos_*)   [ -f "$dest/macos.zip" ] ;;
        android_*) [ -f "$dest/$id.apk" ] ;;
        *)         [ -f "$dest/$id" ] ;;
    esac
}

# Desde 4.8-beta1 hay simbolos de debug por template:
# Godot_v<ver>_[mono_]debugsymbols_<id>.zip, con <id> = linux_debug.x86_64,
# windows_release_x86_64.exe, macos_debug.arm64, android_release, etc.
# Los de linux/windows son un <id>.debugsymbols que el template referencia por
# nombre (.gnu_debuglink): sirven dejandolos al lado del template, y tambien
# copiandolos al lado de un juego exportado con el. Verificados contra el
# digest sha256 de la API de GitHub.
#
# spec: lista "a,b" de ids, plataformas (todos los ids de esa plataforma) o
# "all". Solo se bajan los de templates instalados.
install_template_symbols() {
    local ver="$1" mono="$2" spec="$3" prefix=""
    [ "$mono" = true ] && prefix="mono_"
    local dest
    dest="$TEMPLATES_BASE/$(templates_name "$ver" "$mono")"
    [ -f "$dest/version.txt" ] || die "los export templates de '$ver' no estan instalados"

    local release available
    release=$(curl -s "${GITHUB_API}/releases/tags/${ver}")
    available=$(jq -r --arg p "Godot_v${ver}_${prefix}debugsymbols_" '
        .assets[]? | .name | select(startswith($p) and endswith(".zip"))
        | ltrimstr($p) | rtrimstr(".zip")' <<<"$release")
    [ -n "$available" ] \
        || die "la release '$ver' no tiene simbolos de debug para los templates (existen desde 4.8-beta1)"

    local item id ids=()
    for item in ${spec//,/ }; do
        if [ "$item" = all ]; then
            ids+=($available)
        elif [[ " $TEMPLATE_PLATFORMS " == *" $item "* ]]; then
            ids+=($(grep "^${item}_" <<<"$available" || true))
        elif grep -qxF "$item" <<<"$available"; then
            if symbols_template_installed "$dest" "$item"; then
                ids+=("$item")
            else
                echo "Aviso: el template de '$item' no esta instalado, se omiten sus simbolos" >&2
            fi
        else
            die "no hay simbolos '$item'. Disponibles: $(tr '\n' ' ' <<<"$available")"
        fi
    done

    local todo=() total=0 size
    for id in $(printf '%s\n' "${ids[@]}" | sort -u); do
        symbols_template_installed "$dest" "$id" || continue
        if [ -e "$dest/$id.debugsymbols" ] || [ -e "$dest/godot_$id.dSYM" ]; then
            echo "'$id' ya tiene los simbolos de debug."
            continue
        fi
        todo+=("$id")
        size=$(jq -r --arg f "Godot_v${ver}_${prefix}debugsymbols_${id}.zip" \
            '.assets[] | select(.name==$f) | .size' <<<"$release")
        total=$((total + size))
    done
    if [ ${#todo[@]} -eq 0 ]; then
        echo "No hay simbolos de templates para descargar."
        return
    fi

    echo "Simbolos de debug a descargar: ${todo[*]}"
    echo "Total: $(numfmt --to=iec "$total") de descarga, ~3x en disco"
    if [ "$total" -gt $((1024 ** 3)) ]; then
        confirm "¿Continuar?" || { echo "Cancelado."; return; }
    fi

    TMP=$(mktemp -d -p "$TEMPLATES_BASE" .godot-manager.XXXXXX)
    trap 'rm -rf "$TMP"' EXIT
    for id in "${todo[@]}"; do
        local asset="Godot_v${ver}_${prefix}debugsymbols_${id}.zip" digest
        digest=$(jq -r --arg f "$asset" \
            '.assets[] | select(.name==$f) | .digest // "" | sub("^sha256:"; "")' <<<"$release")
        download_verified "${GITHUB_DL}/${ver}/${asset}" "$TMP/$id.zip" sha256 "$digest"
        # el de android trae una carpeta por ABI; va aparte para no mezclarla
        local into="$dest"
        [[ "$id" == android* ]] && into="$dest/$id.debugsymbols"
        unzip -q -o "$TMP/$id.zip" -d "$into"
        rm -f "$TMP/$id.zip"
        echo "Simbolos de $id instalados en $into"
    done
    rm -rf "$TMP"
    trap - EXIT
}

cmd_templates() {
    local ver="$1"
    [ -n "$ver" ] || die "uso: godot-manager templates <version> [--mono] [--platforms=<p>,...] [--debugsymbols[=<id|plataforma>,...|all]] [--debugsymbolsonly]"
    shift
    local mono=false platforms="" symbols="" only=false
    for opt in "$@"; do
        case "$opt" in
            --mono) mono=true ;;
            --platforms=*) platforms=$(parse_platforms "${opt#*=}") ;;
            --debugsymbols) symbols=default ;;
            --debugsymbols=*) symbols="${opt#*=}" ;;
            --debugsymbolsonly) only=true ;;
            *) die "opcion desconocida '$opt'" ;;
        esac
    done
    # sin lista explicita, los simbolos siguen a --platforms; si no se eligieron:
    # linux x86_64, o con --debugsymbolsonly todo lo instalado
    if [ "$symbols" = default ] || { [ "$only" = true ] && [ -z "$symbols" ]; }; then
        if [ -n "$platforms" ]; then
            symbols="${platforms// /,}"
        elif [ "$only" = true ]; then
            symbols=all
        else
            symbols="$DEFAULT_TEMPLATE_SYMBOLS"
        fi
    fi

    [ "$only" = true ] || install_templates "$ver" "$mono" "${platforms:-$TEMPLATE_PLATFORMS}"
    [ -z "$symbols" ] || install_template_symbols "$ver" "$mono" "$symbols"
}

cmd_install() {
    local ver="$1"
    [ -n "$ver" ] || die "uso: godot-manager install <version> [--mono] [--debugsymbols] [--templates] [--platforms=<p>,...]"
    shift
    local mono=false symbols=false templates=false platforms=""
    for opt in "$@"; do
        case "$opt" in
            --mono) mono=true ;;
            --debugsymbols) symbols=true ;;
            --templates) templates=true ;;
            --platforms=*) templates=true; platforms="$opt" ;;
            *) die "opcion desconocida '$opt'" ;;
        esac
    done

    local dest_name="$ver" asset
    if [ "$mono" = true ]; then
        dest_name="${ver}-mono"
        asset="Godot_v${ver}_mono_linux_x86_64.zip"
    else
        asset="Godot_v${ver}_linux.x86_64.zip"
    fi
    local dest="$VERSIONS_DIR/$dest_name"

    if [ -x "$dest/godot" ]; then
        echo "'$dest_name' ya esta instalada."
    else
        TMP=$(mktemp -d)
        trap 'rm -rf "$TMP"' EXIT
        download_verified "${GITHUB_DL}/${ver}/${asset}" "$TMP/godot.zip" \
            sha512 "$(manifest_checksum "$ver" "$asset")"
        unzip -q "$TMP/godot.zip" -d "$TMP/extracted"
        mkdir -p "$dest"

        local bin
        if [ "$mono" = true ]; then
            # el zip mono trae una carpeta con el binario + GodotSharp/
            cp -r "$TMP/extracted"/*/. "$dest/"
            bin=$(find "$dest" -maxdepth 1 -type f -name "Godot_v*")
            chmod +x "$bin"
            ln -sfn "$(basename "$bin")" "$dest/godot"
        else
            bin=$(find "$TMP/extracted" -maxdepth 1 -type f -name "Godot_v*")
            install -m 755 "$bin" "$dest/godot"
        fi
        rm -rf "$TMP"
        trap - EXIT
        echo "Instalado en $dest"
    fi

    if [ "$symbols" = true ]; then
        cmd_symbols "$dest_name"
    fi
    if [ "$templates" = true ]; then
        local targs=()
        [ "$mono" = true ] && targs+=(--mono)
        [ -n "$platforms" ] && targs+=("$platforms")
        [ "$symbols" = true ] && targs+=(--debugsymbols)
        cmd_templates "$ver" "${targs[@]}"
    fi
}

confirm() {
    local answer
    read -r -p "$1 [s/N] " answer || true
    [[ "$answer" =~ ^[sSyY]$ ]]
}

# Carpeta de export templates que usa un binario. Godot la nombra con
# "<version>.<status>[.mono]", que es su --version sin ".<build>.<hash>"
# (o sin ".<build>" si se compilo fuera de git). Imprime la que exista.
templates_dir_for() {
    local full base="$TEMPLATES_BASE"
    full=$("$1" --headless --version 2>/dev/null | tail -n1) || return 0
    [ -n "$full" ] || return 0
    local candidate
    for candidate in "${full%.*.*}" "${full%.*}"; do
        if [ -d "$base/$candidate" ]; then
            echo "$base/$candidate"
            return
        fi
    done
}

cmd_remove() {
    local name="$1"
    [ -n "$name" ] || die "uso: godot-manager remove <version>"
    local bin
    bin=$(require_installed "$name")
    local dir="$VERSIONS_DIR/$name"

    # hay que resolverlo antes de borrar el binario
    local templates
    templates=$(templates_dir_for "$bin")

    local is_default=false
    [ "$(readlink -f "$GODOT_DIR/current" 2>/dev/null)" = "$(readlink -f "$bin")" ] && is_default=true

    echo "Se va a borrar $dir ($(du -sh "$dir" 2>/dev/null | cut -f1))"
    [ "$is_default" = true ] && echo "Aviso: '$name' es la version default; va a quedar sin default."
    confirm "¿Borrar '$name'?" || { echo "Cancelado."; return; }

    rm -rf "$dir"
    [ "$is_default" = true ] && rm -f "$GODOT_DIR/current"
    echo "Borrada '$name'"

    [ -n "$templates" ] || return 0
    # otra version instalada puede usar la misma carpeta de templates
    local v
    for v in "$VERSIONS_DIR"/*/; do
        [ -x "$v/godot" ] || continue
        if [ "$(templates_dir_for "$v/godot")" = "$templates" ]; then
            echo "Aviso: $(basename "$v") tambien usa $templates"
            break
        fi
    done
    if confirm "¿Borrar tambien los export templates en $templates ($(du -sh "$templates" | cut -f1))?"; then
        rm -rf "$templates"
        echo "Templates borrados"
    fi
}

usage() {
    cat <<EOF
Uso: godot-manager <comando> [args]

Comandos:
  list                              Lista versiones instaladas
  list-remote [stable|dev|latest]   Lista versiones disponibles en GitHub (todas, filtradas, o la ultima de cada una)
  install <ver> [--mono] [--debugsymbols] [--templates] [--platforms=<p>,...]
                                    Descarga, verifica checksum e instala una version oficial
                                    (--templates/--platforms agregan los export templates, como
                                    'templates'; --debugsymbols aplica al editor y a los templates)
  symbols <ver>                     Agrega los simbolos de debug a una version oficial instalada (>= 4.8-beta1)
  templates <ver> [--mono] [--platforms=<p>,...] [--debugsymbols[=<id|plataforma>,...|all]]
            [--debugsymbolsonly]
                                    Instala los export templates oficiales de una version y,
                                    opcionalmente, sus simbolos de debug (>= 4.8-beta1).
                                    --platforms: $TEMPLATE_PLATFORMS
                                      (default: todas; baja solo los archivos de las elegidas)
                                    --debugsymbols sin lista: los de --platforms, o
                                      $DEFAULT_TEMPLATE_SYMBOLS
                                      Ids: linux_debug.arm64, windows_release_x86_64.exe,
                                      macos_debug.arm64, android_release...
                                    --debugsymbolsonly: no toca los templates, solo baja los
                                      simbolos de los ya instalados (todos, o los filtrados)
  add <nombre> <path> [--symlink]   Agrega un binario custom (build propio)
  remove <ver>                      Borra una version (y pregunta si borrar sus export templates)
  set <ver>                         Setea la version default global
  set-local <ver>                   Setea la version para el proyecto actual (.godot-version)
  which                             Muestra que binario usaria 'godot' en el directorio actual
  run [args...]                     Corre la version que corresponde al directorio actual (lo que hace 'godot')
  launch <ver> [args...]            Corre una version puntual sin cambiar la default

Variables:
  GODOT_DIR                         Raiz de las versiones (default: /opt/godot)
EOF
}

cmd="$1"
shift || true
case "$cmd" in
    list)        cmd_list ;;
    list-remote) cmd_list_remote "$1" ;;
    install)     cmd_install "$@" ;;
    symbols)     cmd_symbols "$1" ;;
    templates)   cmd_templates "$@" ;;
    add)         cmd_add "$@" ;;
    remove)      cmd_remove "$1" ;;
    set)         cmd_set "$1" ;;
    set-local)   cmd_set_local "$1" ;;
    which)       cmd_which ;;
    run)         cmd_run "$@" ;;
    launch)      cmd_launch "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; exit 1 ;;
esac
