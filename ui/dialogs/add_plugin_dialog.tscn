[gd_scene format=3]

[ext_resource type="Script" path="res://dialogs/add_plugin_dialog.gd" id="1_apd"]

[node name="AddPluginDialog" type="AcceptDialog"]
title = "Agregar plugin"
size = Vector2i(720, 600)
min_size = Vector2i(560, 440)
ok_button_text = "Cerrar"
script = ExtResource("1_apd")

[node name="Content" type="VBoxContainer" parent="."]
theme_override_constants/separation = 8

[node name="FeaturedLabel" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Nuestros plugins:"

[node name="Featured" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="Sep" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="SearchRow" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Query" type="LineEdit" parent="Content/SearchRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Buscar en el Asset Store de Godot…"
clear_button_enabled = true

[node name="SearchButton" type="Button" parent="Content/SearchRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Buscar"

[node name="SearchStatus" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text_overrun_behavior = 3

[node name="ListPanel" type="PanelContainer" parent="Content"]
custom_minimum_size = Vector2(0, 220)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"ListPanel"

[node name="Scroll" type="ScrollContainer" parent="Content/ListPanel"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Content/ListPanel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Results" type="VBoxContainer" parent="Content/ListPanel/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="More" type="Button" parent="Content/ListPanel/Scroll/List"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 4
text = "Más resultados"

[node name="Sep2" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="SourceRow" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Source" type="LineEdit" parent="Content/SourceRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Otra fuente: github:owner/repo, store:publisher/slug o la URL"
clear_button_enabled = true

[node name="AddSource" type="Button" parent="Content/SourceRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Agregar"

[node name="Pin" type="CheckBox" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Queda en esa versión: Actualizar no lo toca (sirve si el proyecto usa un Godot fijo)"
text = "Fijar la versión que se instale"
