; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Manager"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[autoload]

GmCli="*res://cli/gm_cli.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_agent/plugin.cfg", "res://addons/scope_compass/plugin.cfg")

[input]

gm_search={
"deadzone": 0.2,
"events": [Object(InputEventKey,
"resource_local_to_scene": false,
"resource_name": "",
"device": 16,
"window_id": 0,
"alt_pressed": false,
"shift_pressed": false,
"ctrl_pressed": true,
"meta_pressed": false,
"pressed": false,
"keycode": 0,
"physical_keycode": 70,
"key_label": 0,
"unicode": 0,
"location": 0,
"echo": false,
"script": null
)]
}
